# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# ─── Supabase (client) ────────────────────────────────────────────────
# The anon/publishable key is safe to expose in the browser; it is
# protected by Row Level Security policies on the database.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<your-project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# ─── Supabase (server-side only) ──────────────────────────────────────
# NOT prefixed with VITE_ on purpose — this must never reach the browser.
# Used by Supabase Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Hugging Face ─────────────────────────────────────────────────────
# Server-side token, consumed by the sentiment-analysis Edge Function.
# Set it as a function secret:
#   npx supabase secrets set HUGGINGFACE_API_KEY=hf_xxx
HUGGINGFACE_API_KEY=<your-huggingface-token>

# WARNING: this VITE_-prefixed copy is compiled into the public client
# bundle and can be extracted by anyone who loads the site. It is still
# read by src/pages/TripGenie.tsx. Move that call behind an Edge Function
# (as sentiment-analysis already does) and then delete this line.
VITE_HUGGINGFACE_API_KEY=<your-huggingface-token>

# ─── Weather ──────────────────────────────────────────────────────────
# Also exposed in the client bundle. Restrict it by domain/referrer in
# your OpenWeatherMap account settings.
VITE_WEATHER_API_KEY=<your-openweathermap-key>
